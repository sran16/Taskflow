NODE_ENV=development
PORT=4000

# Connexion MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Authentification JWT — remplace par une longue chaîne aléatoire
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Origine(s) autorisée(s) pour CORS (le frontend)
CORS_ORIGIN=http://localhost:5173
